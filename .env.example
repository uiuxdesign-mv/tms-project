# Isi file JSON service account Google Cloud (dalam SATU baris, dibungkus tanda kutip tunggal).
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account", ... }'

# Spreadsheet ID untuk tiap "tabel" (masing-masing file Google Sheets terpisah di folder TMS Database)
SHEET_ID_USERS=
SHEET_ID_ROLES=
SHEET_ID_CLIENTS=
SHEET_ID_PROJECTS=
SHEET_ID_PRIORITIES=
SHEET_ID_TASK_TYPES=
SHEET_ID_EMPLOYMENT_TYPES=
SHEET_ID_STATUSES=
SHEET_ID_MENU_ACCESS=
SHEET_ID_TASKS=
SHEET_ID_AUDIT_LOG=
SHEET_ID_TASK_TIME_LOGS=
SHEET_ID_TASK_COMMENTS=

# String acak panjang untuk menandatangani session JWT. Generate sendiri, jangan pakai contoh ini.
SESSION_SECRET=ganti-dengan-string-acak-panjang

# Fase 9 (Comments + Lampiran): OAuth ke Google Drive PRIBADI (bukan service account, lihat
# src/lib/google/drive-oauth.ts untuk alasannya). Client ID/Secret dari Google Cloud Console >
# APIs & Services > Credentials. Redirect URI harus didaftarkan persis sama di sana.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# Opsional — kalau tidak diisi, otomatis dihitung dari NEXT_PUBLIC_SITE_URL/VERCEL_URL atau fallback localhost:3311.
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=
# Diisi OTOMATIS oleh halaman /api/auth/google-drive/callback setelah proses "Connect" sekali di awal — salin ke sini & ke Vercel.
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_ATTACHMENTS_FOLDER_ID=
